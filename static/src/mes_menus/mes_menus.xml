<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="is_menu_utilisateur.MesMenus" owl="1">
        <div class="o_action is_mes_menus h-100 overflow-auto">
            <div class="is_mes_menus_entete d-flex flex-wrap align-items-center gap-2 mb-2">
                <h2 class="me-3 mb-0">Mes menus</h2>
                <button class="btn btn-secondary btn-sm" t-on-click="toutPlier">Tout plier</button>
                <button class="btn btn-secondary btn-sm" t-on-click="toutDeplier">Tout déplier</button>
                <input type="search" class="form-control form-control-sm is_mes_menus_recherche"
                       placeholder="🔍 Rechercher un menu" t-model="state.recherche"/>
            </div>
            <p class="text-muted mb-3">
                Décochez un menu pour ne plus l'afficher dans la barre de menus (ses sous-menus sont masqués aussi).
            </p>
            <div class="is_mes_menus_arbre">
                <t t-foreach="lignes" t-as="ligne" t-key="ligne.noeud.id">
                    <div class="is_mes_menus_ligne d-flex align-items-center"
                         t-att-class="{'is_grise': ligne.grise, 'is_racine': ligne.niveau === 0}"
                         t-attf-style="padding-left: {{ ligne.niveau * 24 }}px;">
                        <span class="is_mes_menus_fleche" t-on-click="() => this.basculerPli(ligne.noeud)">
                            <i t-if="ligne.noeud.enfants.length"
                               t-attf-class="fa fa-fw {{ ligne.ouvert ? 'fa-caret-down' : 'fa-caret-right' }}"/>
                            <i t-else="" class="fa fa-fw"/>
                        </span>
                        <input type="checkbox" class="form-check-input me-2 mt-0"
                               t-att-checked="!ligne.noeud.masque"
                               t-on-change="() => this.basculerMasque(ligne.noeud)"/>
                        <span class="is_mes_menus_nom" t-on-click="() => this.basculerPli(ligne.noeud)"
                              t-esc="ligne.noeud.name"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
